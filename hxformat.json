{
  "lineEnds": {
    "leftCurly": "both",
    "rightCurly": "both",
    "emptyCurly": "break",
    "objectLiteralCurly": {
      "leftCurly": "after"
    }
  },
  "sameLine": {
    "ifElse": "next",
    "doWhile": "next",
    "tryBody": "next",
    "tryCatch": "next"
  },
  "indentation": {
    "character": "\t",
    "tabWidth": 4
  },
  "whitespace": {
    "betweenFunctionNameAndParenthesis": false,
    "betweenControlFlowKeywordAndParenthesis": true
  },
  "wrapping": {
    "maxLineLength": 120
  }
}
