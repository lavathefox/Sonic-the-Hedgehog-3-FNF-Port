+#!/usr/bin/env bash
+# Rewrites direct sys.* file calls to the FS layer (backend/FS.hx) so the Switch build can
+# redirect reads to romfs:/ and writes to the SD card.
+#
+# Usage (run from the repo root, review `git diff` after each part):
+#   bash setup/switch_codemod.sh <path> [<path> ...]
+# Example, in parts:
+#   bash setup/switch_codemod.sh source/backend source/save source/util source/shaders source/Main.hx
+#   bash setup/switch_codemod.sh source/states source/objects source/options source/cutscenes source/flxanimate source/hscript
+#   bash setup/switch_codemod.sh source/psychlua
 set -euo pipefail
 
 if [ ! -d source ]; then
-	echo "Rode na raiz do repositorio (pasta 'source' nao encontrada)." >&2
+	echo "Run this from the repository root ('source' folder not found)." >&2
 	exit 1
 fi
 
-SKIP='source/backend/FS.hx|source/backend/PlatformUtil.hx|source_html5/'
+if [ "$#" -eq 0 ]; then
+	echo "Pass at least one file or folder (see the usage at the top of this script)." >&2
+	exit 1
+fi
+
+# Never rewritten: the FS layer itself, the browser shims, HTML5 overrides, platform glue,
+# dead code and the editors (they are not shipped on Switch).
+SKIP='source/backend/FS\.hx|source/backend/PlatformUtil\.hx|source/backend/web/|source_html5/|source/external/|source/unused/|source/states/editors/'
 
-files=$(grep -rlE 'FileSystem\.|File\.(getContent|getBytes|saveContent|saveBytes)|BitmapData\.fromFile|Sound\.fromFile' source --include='*.hx' | grep -Ev "$SKIP" || true)
+files=$(grep -rlE 'FileSystem\.|File\.(getContent|getBytes|saveContent|saveBytes|write|append)|BitmapData\.fromFile|Sound\.fromFile' "$@" --include='*.hx' | grep -Ev "$SKIP" || true)
 
 if [ -z "$files" ]; then
-	echo "Nada para alterar."
+	echo "Nothing to change."
 	exit 0
 fi
 
@@ -19,14 +36,20 @@ for f in $files; do
 	before=$(md5sum "$f" | cut -d' ' -f1)
 
 	sed -i -E \
+		-e 's/\bFileSystem\.stat\(([^()]*)\)\.size\b/FS.size(\1)/g' \
 		-e 's/\bFileSystem\.exists\(/FS.exists(/g' \
 		-e 's/\bFileSystem\.isDirectory\(/FS.isDirectory(/g' \
 		-e 's/\bFileSystem\.readDirectory\(/FS.readDirectory(/g' \
 		-e 's/\bFileSystem\.createDirectory\(/FS.createDirectory(/g' \
+		-e 's/\bFileSystem\.deleteFile\(/FS.deleteFile(/g' \
+		-e 's/\bFileSystem\.deleteDirectory\(/FS.deleteDirectory(/g' \
+		-e 's/\bFileSystem\.rename\(/FS.rename(/g' \
 		-e 's/\bFile\.getContent\(/FS.getContent(/g' \
 		-e 's/\bFile\.getBytes\(/FS.getBytes(/g' \
 		-e 's/\bFile\.saveContent\(/FS.saveContent(/g' \
 		-e 's/\bFile\.saveBytes\(/FS.saveBytes(/g' \
+		-e 's/\bFile\.write\(/FS.openWrite(/g' \
+		-e 's/\bFile\.append\(/FS.openAppend(/g' \
 		-e 's/\bBitmapData\.fromFile\(/FS.loadBitmap(/g' \
 		-e 's/\bSound\.fromFile\(/FS.loadSound(/g' \
 		"$f"
@@ -34,20 +57,17 @@ for f in $files; do
 	after=$(md5sum "$f" | cut -d' ' -f1)
 	if [ "$before" != "$after" ]; then
 		count=$((count + 1))
-		echo "alterado: $f"
+		echo "changed: $f"
 	fi
 done
 
 if [ -f source/import.hx ] && ! grep -q 'import backend.FS;' source/import.hx; then
 	printf '\nimport backend.FS;\n' >> source/import.hx
-	echo "adicionado 'import backend.FS;' em source/import.hx"
-elif [ ! -f source/import.hx ]; then
-	echo "AVISO: source/import.hx nao existe; adicione 'import backend.FS;' nos arquivos alterados." >&2
+	echo "added 'import backend.FS;' to source/import.hx"
 fi
 
