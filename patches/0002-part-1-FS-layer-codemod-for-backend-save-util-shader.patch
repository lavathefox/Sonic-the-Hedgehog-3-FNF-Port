+#if SWITCH_BUILD
+// Heap size override for the Switch build.
+//
+// libnx's default __libnx_initheap asks the kernel for ALL the memory the process can get
+// (about 3 GB). Real hardware launched from the Homebrew Menu receives a heap from the loader, so
+// that path is left untouched below. When the .nro is opened directly (emulators such as Ryujinx),
+// there is no loader heap and the default request can exceed the host's RAM + page file, which
+// crashes the whole emulator ("paging file is too small"). The fallback is capped here.
+// Lower SWITCH_FALLBACK_HEAP_BYTES (e.g. 0x20000000 = 512 MB) if the emulator still runs out of memory.
+@:cppFileCode('
+extern "C" {
+	typedef unsigned int NxResult;
+	extern char* fake_heap_start;
+	extern char* fake_heap_end;
+	bool envHasHeapOverride(void);
+	void* envGetHeapOverrideAddr(void);
+	unsigned long long envGetHeapOverrideSize(void);
+	NxResult svcSetHeapSize(void** out_addr, unsigned long long size);
+
+	#define SWITCH_FALLBACK_HEAP_BYTES 0x40000000ULL
+
+	void __libnx_initheap(void)
+	{
+		void* addr = 0;
+		unsigned long long size = 0;
+
+		if (envHasHeapOverride())
+		{
+			addr = envGetHeapOverrideAddr();
+			size = envGetHeapOverrideSize();
+		}
+		else
+		{
+			size = SWITCH_FALLBACK_HEAP_BYTES;
+			if (svcSetHeapSize(&addr, size) != 0)
+			{
+				addr = 0;
+				size = 0;
+			}
+		}
+
+		fake_heap_start = (char*)addr;
+		fake_heap_end = (char*)addr + size;
+	}
+}
+')
+#end
 class Main extends Sprite
 {
     public static final game = {
