 	public static inline var hasKeyboard:Bool = #if (mobile || CONSOLE_BUILD) false #else true #end;
 
+	/** Folder on the SD card where the Switch build stores mods, saves and logs. */
+	public static inline var DATA_DIR:String = #if SWITCH_BUILD 'sdmc:/switch/Sonic3-FNF-Port' #else '.' #end;
+
+	/** True when the path already names a device (e.g. "sdmc:/..." or "romfs:/..."). */
+	static inline function hasDevice(path:String):Bool
+		return path.indexOf(':/') > 0;
+
+	static function stripDotSlash(path:String):String
+	{
+		while (StringTools.startsWith(path, './'))
+			path = path.substr(2);
+		return path;
+	}
+
+	/**
+	 * Path used for READING. On Switch, `mods/` lives on the SD card and everything
+	 * else (assets, data files) is read from the read-only romfs inside the .nro.
+	 */
+	public static function toFileSystemPath(path:String):String
+	{
+		#if SWITCH_BUILD
+		if (path == null || path == '' || hasDevice(path))
+			return path;
+		path = stripDotSlash(path);
+		if (path == 'mods' || StringTools.startsWith(path, 'mods/'))
+			return DATA_DIR + '/' + path;
+		return 'romfs:/' + path;
+		#else
+		return path;
+		#end
+	}
+
+	/** Path used for WRITING. On Switch the romfs is read-only, so relative paths go to the SD card. */
+	public static function toWritablePath(path:String):String
+	{
+		#if SWITCH_BUILD
+		if (path == null || path == '' || hasDevice(path))
+			return path;
+		return DATA_DIR + '/' + stripDotSlash(path);
+		#else
+		return path;
+		#end
+	}
+
