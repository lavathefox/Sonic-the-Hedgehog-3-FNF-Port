diff --git a/source/psychlua/ExtraFunctions.hx b/source/psychlua/ExtraFunctions.hx
index 6b11ca7..47d6e8b 100644
--- a/source/psychlua/ExtraFunctions.hx
+++ b/source/psychlua/ExtraFunctions.hx
@@ -150,9 +150,9 @@ class ExtraFunctions
 		// File management
 		Lua_helper.add_callback(lua, "checkFileExists", function(filename:String, ?absolute:Bool = false) {
 			#if MODS_ALLOWED
-			if(absolute) return FileSystem.exists(filename);
+			if(absolute) return FS.exists(filename);
 
-			return FileSystem.exists(Paths.getPath(filename, TEXT));
+			return FS.exists(Paths.getPath(filename, TEXT));
 
 			#else
 			if(absolute) return Assets.exists(filename, TEXT);
@@ -165,10 +165,10 @@ class ExtraFunctions
 			try {
 				#if MODS_ALLOWED
 				if(!absolute)
-					File.saveContent(Paths.mods(path), content);
+					FS.saveContent(Paths.mods(path), content);
 				else
 				#end
-					File.saveContent(path, content);
+					FS.saveContent(path, content);
 
 				return true;
 			} catch (e:Dynamic) {
@@ -181,9 +181,9 @@ class ExtraFunctions
 			try {
 				var lePath:String = path;
 				if(!absolute) lePath = Paths.getPath(path, TEXT, !ignoreModFolders);
-				if(FileSystem.exists(lePath))
+				if(FS.exists(lePath))
 				{
-					FileSystem.deleteFile(lePath);
+					FS.deleteFile(lePath);
 					return true;
 				}
 			} catch (e:Dynamic) {
@@ -197,8 +197,8 @@ class ExtraFunctions
 		Lua_helper.add_callback(lua, "directoryFileList", function(folder:String) {
 			var list:Array<String> = [];
 			#if sys
-			if(FileSystem.exists(folder)) {
-				for (folder in FileSystem.readDirectory(folder)) {
+			if(FS.exists(folder)) {
+				for (folder in FS.readDirectory(folder)) {
 					if (!list.contains(folder)) {
 						list.push(folder);
 					}
