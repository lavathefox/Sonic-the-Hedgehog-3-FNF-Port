<?xml version="1.0" encoding="utf-8"?>
<project>
    <!-- Sonic the Hedgehog 3 (FNF Port) - cross-platform build configuration -->
    <app title="Sonic the Hedgehog 3 (FNF Port)" file="Sonic3Funkin" packageName="me.funkin.sonic3" package="me.funkin.sonic3" main="Main" version="0.2.8" company="ShadowMario" />
    <app preloader="flixel.system.FlxPreloader" />
    <set name="APP_ID" value="0x0100f6c013bbc000" />
    <set name="SWF_VERSION" value="11.8" />

    <define name="SWITCH_BUILD" if="switch" />

    <!-- Features are opt-in by platform: browser builds avoid native dependencies. -->
    <define name="MODS_ALLOWED" if="desktop || android || switch" />
    <define name="HSCRIPT_ALLOWED" if="desktop || mobile || switch" />
    <define name="LUA_ALLOWED" if="desktop || mobile || switch" />
    <define name="ACHIEVEMENTS_ALLOWED" />
    <define name="TRANSLATIONS_ALLOWED" />
    <define name="DISCORD_ALLOWED" if="desktop" unless="switch" />
    <define name="IRIS_DEBUG" if="debug" />
    <define name="MULTITHREADED_LOADING" if="desktop" unless="switch" />
    <define name="SHOW_LOADING_SCREEN" />
    <define name="PSYCH_WATERMARKS" />
    <section unless="switch">
        <define name="CRASH_HANDLER" if="release" unless="html5" />
    </section>
    <define name="CHECK_FOR_UPDATES" if="desktop officialBuild" />
    <haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB" if="LUA_ALLOWED" />
    <section if="officialBuild">
        <define name="TITLE_SCREEN_EASTER_EGG" />
        <define name="BASE_GAME_FILES" />
        <define name="VIDEOS_ALLOWED" if="windows || linux || android || mac" unless="32bits" />
    </section>

    <section if="switch">
        <haxedef name="lime-opengl" />
        <haxedef name="lime-cairo" value="false" />
        <set name="LIME_CAIRO" value="0" />
        <set name="LIME_OPENGL" value="1" />

        <haxelib name="hx_libnx" />

        <!-- Para `lime run switch` (envio por rede via nxlink). Troque pelo IP do seu Switch. -->
        <!-- <config:switch ip="192.168.x.x" /> -->

        <config:switch libs="lua5.1" if="LUA_ALLOWED" />
    </section>

    <!-- HTML5: the source_html5 classpath overrides browser-incompatible classes. -->
    <classpath name="source" />
    <classpath name="source_html5" if="html5" />
    <window width="959" height="670" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />
    <window if="html5" resizable="true" fullscreen="false" />
    <window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
    <window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false" />
    <window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false" hardware="true" />

    <!-- Native mobile integrations. Scoped to Android to avoid other targets. -->
    <android permission="android.permission.INTERNET" if="android" />
    <android permission="android.permission.VIBRATE" if="android" />
    <android permission="android.permission.READ_EXTERNAL_STORAGE" if="android" />
    <android permission="android.permission.WRITE_EXTERNAL_STORAGE" if="android" />
    <android permission="android.permission.MANAGE_EXTERNAL_STORAGE" if="android" />
    <template path="project/StorageHelper.java" rename="app/src/main/java/me/funkin/sonic3/StorageHelper.java" if="android" />
    <template path="project/DeviceHelper.java" rename="app/src/main/java/me/funkin/sonic3/DeviceHelper.java" if="android" />
    <template path="project/HapticsHelper.java" rename="app/src/main/java/me/funkin/sonic3/HapticsHelper.java" if="android" />

    <!-- Output layout -->
    <set name="BUILD_DIR" value="export/debug" if="debug" />
    <set name="BUILD_DIR" value="export/release" unless="debug" />
    <set name="BUILD_DIR" value="export/32bit" if="32bits" />

    <!-- Browser audio uses MP3; native targets use OGG. -->
    <assets path="assets/fonts" />
    <assets path="assets/shared" exclude="*.ogg" if="html5" />
    <assets path="assets/shared" exclude="*.mp3" unless="html5" />
    <assets path="assets/embed" exclude="*.ogg" if="html5" embed="true" />
    <assets path="assets/embed" exclude="*.mp3" unless="html5" embed="true" />
    <assets path="assets/videos" if="VIDEOS_ALLOWED" />
    <assets path="assets/songs" exclude="*.ogg" if="html5" />
    <assets path="assets/songs" exclude="*.mp3" unless="html5" />
    <assets path="assets/week_assets" rename="assets" exclude="*.ogg" if="html5" />
    <assets path="assets/week_assets" rename="assets" exclude="*.mp3" unless="html5" />
    <section if="TITLE_SCREEN_EASTER_EGG">
        <assets path="assets/secrets" rename="assets/shared" exclude="*.ogg" if="html5" />
        <assets path="assets/secrets" rename="assets/shared" exclude="*.mp3" unless="html5" />
    </section>
    <section if="TRANSLATIONS_ALLOWED">
        <assets path="assets/translations" rename="assets" exclude="*.ogg" if="html5" />
        <assets path="assets/translations" rename="assets" exclude="*.mp3" unless="html5" />
    </section>
    <section if="BASE_GAME_FILES">
        <assets path="assets/base_game" rename="assets" exclude="*.ogg" if="html5" />
        <assets path="assets/base_game" rename="assets" exclude="*.mp3" unless="html5" />
        <haxelib name="grig.audio" />
        <haxelib name="funkin.vis" />
    </section>
    <!-- HTML5: the mod's songs are NOT bundled here. The workflow copies them next to the game
         (export/release/html5/bin/assets/songs) and LoadingState downloads only the song you pick. -->
    <section if="html5">
        <assets path="html5_stage/shared" rename="assets/shared" exclude="*.ogg" />
        <assets path="html5_stage/fonts" rename="assets/fonts" exclude="*.ogg" />
    </section>
    <section if="MODS_ALLOWED">
        <assets path="example_mods" rename="mods" embed="false" type="template" if="desktop" unless="mac" />
        <assets path="example_mods" rename="mods" embed="false" if="mac" />
        <assets path="example_mods" rename="mods" embed="false" if="android" />
        <assets path="list.txt" rename="modsList.txt" />
    </section>
    <section if="desktop">
        <assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows" />
        <assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows" />
    </section>

    <!-- Keep versions aligned with the existing repository. -->
    <haxelib name="flixel" version="5.6.1" />
    <haxelib name="flixel-addons" version="3.2.2" />
    <haxelib name="tjson" version="1.4.0" />
    <haxelib name="linc_luajit" if="LUA_ALLOWED" />
    <haxelib name="hscript-iris" version="1.1.3" if="HSCRIPT_ALLOWED" />
    <haxelib name="hxvlc" version="2.0.1" if="VIDEOS_ALLOWED" unless="switch" />
    <haxelib name="hxdiscord_rpc" version="1.2.4" if="DISCORD_ALLOWED" />
    <haxelib name="flxanimate" />
    <section unless="switch">
        <haxelib name="hxcpp-debug-server" if="debug" unless="html5" />
    </section>

    <haxedef name="DISCORD_DISABLE_IO_THREAD" if="DISCORD_ALLOWED" />
    <haxedef name="NO_PRECOMPILED_HEADERS" if="linux || switch" />
    <haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
    <haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
    <haxedef name="x86_BUILD" if="32bits" />
    <haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
    <haxedef name="FLX_NO_DEBUG" unless="debug" />
    <haxedef name="HXC_DEBUG_TRACE" if="debug" />
    <haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
    <haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
    <haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
    <haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />
    <haxedef name="no-deprecation-warnings" />
    <haxedef name="message.reporting" value="pretty" />
    <haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

    <!-- Do not include nonexistent Haxe packages through unconditional macros. -->
    <assets path="art/icons/iconOG.png" rename="icon.png" if="linux || mac" />
    <icon path="art/icons/icon16.png" size="16" unless="switch" />
    <icon path="art/icons/icon32.png" size="32" unless="switch" />
    <icon path="art/icons/icon64.png" size="64" unless="switch" />
    <icon path="art/icons/iconOG.png" unless="switch" />
    <icon path="art/icons/iconOG.png" size="256" if="switch" />
</project>
